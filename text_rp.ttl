    :patient :c_angela, :c_liza ;
    :time "Several months after kidnapping" ;
    :location "George's Farm" ;
    :description "Angela and Liza sign formal slave contracts on video, agreeing to complete surrender of their bodies. The contracts stipulate that their first children will be their responsibility but all subsequent children will be the masters' responsibility and put up for adoption."@en .

:me_virusDiscovery a :MilestoneEvent ;
    rdfs:label "Discovery of Liza's Virus"@en ;
    :agent :c_george ;
    :patient :c_liza ;
    :time "After scanner use" ;
    :location "The Cave" ;
    :description "George discovers through the scanner that Liza has an unidentified virus that blocks fallopian tubes, causing infertility. The virus spreads through contact and will cause human extinction within 10-20 years if not cured."@en .

:me_pressConference a :MilestoneEvent ;
