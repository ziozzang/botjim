    :location "Alpha-Omega Frat House" ;
    :description "Jerry and Tom kidnap Angela (governor's daughter) and her bodyguard Sherry (actually spy Liza) from a frat party using a stolen security van and the 3H drug."@en .

:me_bombing a :MilestoneEvent ;
    rdfs:label "Medical Arts Building Bombing"@en ;
    :agent :c_jerry, :c_tom ;
    :patient :c_angela ;
    :time "12:01 AM" ;
    :location "University Medical Arts Building" ;
    :description "Terrorists bomb the Medical Arts Building to destroy evidence of the scanner they were stealing. The explosion collapses the building and causes a firestorm killing 165+ people and making Angela and Liza appear dead."@en .

:me_scannerAcquisition a :MilestoneEvent ;
    rdfs:label "Scanner Acquisition"@en ;
    :agent :c_jerry, :c_tom, :c_george, :c_harry ;
    :patient :c_angela, :c_liza ;
    :time "After the bombing" ;
    :location "George's Farm Cave" ;
    :description "The group discovers the Biological Organism Scanner in stolen crates and realizes it can revolutionize diagnostics and enable reproduction, making them targets but also giving them power to save humanity."@en .

:me_slaveContracts a :MilestoneEvent ;
