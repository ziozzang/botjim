    :time "First day of honeymoon, Egypt" ;
    :location "Luxor Hotel, Egypt" ;
    :description "Matthew is abducted from the hotel by Elizabeth's agents. He is drugged and injected with Elizabeth's DNA-altering drug."@en .

:me_firstTransformation a :MilestoneEvent ;
    rdfs:label "First Leg Transformation"@en ;
    :agent :c_matthew ;
    :patient :c_matthew ;
    :time "Day 3, Egypt" ;
    :location "Luxor Hotel, Egypt" ;
    :description "Matthew wakes to find his right leg has transformed into Elizabeth's. He experiences pins and needles as the leg reshapes into a feminine form with a mole on the calf."@en .

:me_secondLeg a :MilestoneEvent ;
    rdfs:label "Second Leg Transformation"@en ;
    :agent :c_matthew ;
    :patient :c_matthew ;
    :time "Day 4, Egypt" ;
    :location "Luxor Hotel, Egypt" ;
    :description "Left leg transforms to match Elizabeth's, completing the leg transformation. Matthew can now only wear women's jeans."@en .

:me_bodyHips a :MilestoneEvent ;
    rdfs:label "Body and Hips Transformation"@en ;
    :agent :c_matthew ;
    :patient :c_matthew ;
    :time "Day 5-6, Egypt" ;
    :location "Luxor Hotel, Egypt" ;
    :description "After taking two pills, Matthew's torso reshapes - shoulders, waist, stomach, hips, and buttocks become Elizabeth's. Womb forms internally."@en .

:me_arms a :MilestoneEvent ;
    rdfs:label "Arm Transformation"@en ;
    :agent :c_matthew ;
    :patient :c_matthew ;
    :time "Day 7, Egypt" ;
    :location "Luxor Hotel, Egypt" ;
    :description "Arms transform into Elizabeth's slender, feminine arms with delicate hands and fingernails. Hair falls out."@en .

:me_face a :MilestoneEvent ;
    rdfs:label "Face and Voice Transformation"@en ;
    :agent :c_matthew ;
    :patient :c_matthew ;
    :time "Day 8, Egypt" ;
    :location "Luxor Hotel, Egypt" ;
    :description "After taking pill nine, Matthew's face reshapes - bones crunch, nose reforms, lips become fuller, eyes turn blue-gray, hair turns auburn. Voice becomes Elizabeth's."@en .

:me_tattoo a :MilestoneEvent ;
    rdfs:label "The Hydra Tattoo"@en ;
    :agent :c_matthew ;
    :patient :c_matthew ;
    :time "Day 10, Egypt" ;
    :location "Japanese Tattoo Shop, Egypt" ;
    :description "Matthew gets a large hydra tattoo done in four hours - covering his body, curling around breasts, the tail ending on the thigh. The tattoo was part of Elizabeth's riddle."@en .

:me_orgasmVagina a :MilestoneEvent ;
    rdfs:label "Orgasm-Triggered Vagina"@en ;
    :agent :c_kat ;
    :patient :c_matthew ;
    :time "Night before last pill" ;
    :location "Luxor Hotel, Egypt" ;
    :description "During lovemaking with Kat, an orgasm triggers the final transformation - Matthew grows a vagina despite not taking the last pill. The coup-de-grace was tied to sexual stimulation."@en .

:me_elizabethReveal a :MilestoneEvent ;
